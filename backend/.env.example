# Copy to .env for local (non-docker) development: `cp .env.example .env`.
# docker-compose.yml sets these directly for the containerized backend.

PORT=8000
PUBLIC_BASE_URL=http://localhost:8000

CACHE_ENABLED=true
REDIRECT_STATUS=302
CACHE_TTL_SECONDS=3600

PGHOST=localhost
PGPORT=5432
PGUSER=app
PGPASSWORD=
PGDATABASE=shortener

REDISHOST=localhost
REDISPORT=6379
